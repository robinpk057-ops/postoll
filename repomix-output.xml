    continuityToNext: "",
    startState: "",
    endState: "",
    transition: "",
    visualPriority: "",
    generationPrompt: requestedScene.description ?? "",
    negativePrompt: "",
  };
}

function findPreviousScene(
  plan: GenerateReelRequest["plan"],
  sceneNumber: number
): DetailedScene | null {
  const scenes = plan.reelProduction?.scenes ?? [];

  return (
