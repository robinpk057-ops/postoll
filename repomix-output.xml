                </span>
              </button>

              <button
                type="button"
                onClick={() =>
                  handleApprovalChange(false)
                }
                className="rounded-xl border px-5 py-3 font-medium transition-all duration-200"
                style={{
                  background:
                    !workflow.requireApproval
                      ? "rgba(139,92,246,.12)"
                      : "var(--background)",

                  borderColor:
                    !workflow.requireApproval
                      ? "#8b5cf6"
                      : "var(--border)",

                  boxShadow:
                    !workflow.requireApproval
                      ? "0 0 0 2px rgba(139,92,246,.08)"
