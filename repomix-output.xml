            ? "#8b5cf6"
            : "var(--border)",
      }}

    >

      <span

        className="absolute top-1 h-5 w-5 rounded-full bg-white shadow"

        style={{
          left:
            enabled
              ? "24px"
              : "4px",
        }}

      />

    </div>

  );

}
