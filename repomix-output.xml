          </div>



          <span className="text-sm">
            Content Source
          </span>




          <div
            className="h-px flex-1"
            style={{
              background:"var(--border)"
            }}
          />




          <div
            className="rounded-full border px-4 py-2 text-sm"
            style={{
              borderColor:"var(--border)",
              color:"var(--muted)"
            }}
          >
            2
          </div>




          <span
            className="hidden text-sm md:block"
            style={{
              color:"var(--muted)"
            }}
