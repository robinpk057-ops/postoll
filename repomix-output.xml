                    return (

                      <button

                        key={item}

                        type="button"

                        onClick={() =>
                          toggleFormat(item)
                        }

                        className="rounded-2xl border p-5 text-left transition-all duration-200 hover:-translate-y-0.5"

                        style={{

                          background:
                            selected
                              ? "rgba(139,92,246,.12)"
                              : "var(--background)",

                          borderColor:
                            selected
                              ? "#8b5cf6"
