        {/* ================================================== */}
        {/* SCHEDULER */}
        {/* ================================================== */}

        {showScheduler && (
          <section className="mb-8 rounded-2xl border border-white/10 bg-[#101112] p-6">

            <div className="mb-6">

              <p className="text-sm font-medium text-purple-400">
