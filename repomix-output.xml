              <div className="mt-5 grid gap-3 sm:grid-cols-2 md:grid-cols-3">

                {approvalOptions.map(
                  (option) => {

                    const selected =
                      workflow.approvalTime ===
                      option.value;

                    return (

                      <button
                        key={option.value}
                        type="button"
                        onClick={() =>
