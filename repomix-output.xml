import { NextResponse } from "next/server";
import sharp from "sharp";

type GenerateImageBody = {
  plan?: {
    title?: string;
    concept?: string;
    caption?: string;
    type?: "post" | "reel";

    creativeIntent?: string;

    visualStrategy?: {
      mainSubject?: string;
      secondarySubjects?: string[];
      environment?: string;
      action?: string;
      mood?: string;
      visualStyle?: string;
      lighting?: string;
      composition?: string;
      camera?: string;
      colorDirection?: string;
    };

    textStrategy?: {
      textRequired?: boolean;
      reason?: string;
      requestedText?: string;
      placement?: string;
      style?: string;
    };

    brandingStrategy?: {
      brandMentioned?: boolean;
      brandName?: string;
      logoRequired?: boolean;
    };

    imageDirection?: string;

    avoid?: string[];

    scenes?: {
      scene: number;
      description: string;
      duration: string;
    }[];
  };

  /*
   * Backwards compatibility.
   */
  title?: string;
  concept?: string;
  caption?: string;
  type?: "post" | "reel";
  imagePrompt?: string;
};

export async function POST(request: Request) {
  try {
    const body =
      (await request.json()) as GenerateImageBody;

    /*
     * ============================================================
     * GET PLAN
     * ============================================================
     */

    const plan = body.plan;

    /*
     * Older CreatePage versions may send fields directly.
     */

    const title =
      plan?.title ||
      body.title ||
      "";

    const concept =
      plan?.concept ||
      body.concept ||
      "";

    const type =
      plan?.type ||
      body.type ||
      "post";

    const creativeIntent =
      plan?.creativeIntent ||
      "";

    const visualStrategy =
      plan?.visualStrategy;

    const textStrategy =
      plan?.textStrategy;

    const brandingStrategy =
      plan?.brandingStrategy;

    const imageDirection =
      plan?.imageDirection ||
      "";

    const avoid =
      plan?.avoid || [];

    /*
     * ============================================================
     * CLOUDFLARE CREDENTIALS
     * ============================================================
     */

    const accountId =
      process.env.CLOUDFLARE_ACCOUNT_ID;

    const apiToken =
      process.env.CLOUDFLARE_API_TOKEN;

    if (!accountId) {
      return NextResponse.json(
        {
          error:
            "CLOUDFLARE_ACCOUNT_ID is missing from .env.local",
        },
        { status: 500 }
      );
    }

    if (!apiToken) {
      return NextResponse.json(
        {
          error:
            "CLOUDFLARE_API_TOKEN is missing from .env.local",
        },
        { status: 500 }
      );
    }

    /*
     * ============================================================
     * EXACT TEXT EXTRACTION
     * ============================================================
     *
     * IMPORTANT:
     *
     * We DO NOT ask FLUX to render the requested text.
     *
     * FLUX generates the clean visual.
     *
     * Sharp adds the exact text afterwards.
     */

    const textRequired =
      textStrategy?.textRequired === true;

    const requestedText =
      typeof textStrategy?.requestedText === "string"
        ? textStrategy.requestedText.trim()
        : "";

    /*
     * Only render text when BOTH conditions are true:
     *
     * 1. Gemini says text is required.
     * 2. There is actual requested text.
     *
     * This prevents accidental invented quotes.
     */

    const shouldRenderText =
      textRequired &&
      requestedText.length > 0;

    console.log(
      "Text required:",
      textRequired
    );

    console.log(
      "Requested text:",
      requestedText
    );

    console.log(
      "Render exact text:",
      shouldRenderText
    );

    /*
     * ============================================================
     * VISUAL STRATEGY
     * ============================================================
     */

    const mainSubject =
      visualStrategy?.mainSubject ||
      concept ||
      title ||
      "the requested subject";

    const secondarySubjects =
      Array.isArray(
        visualStrategy?.secondarySubjects
      )
        ? visualStrategy.secondarySubjects
            .filter(Boolean)
            .slice(0, 5)
            .join(", ")
        : "";

    const environment =
      visualStrategy?.environment ||
      "";

    const action =
      visualStrategy?.action ||
      "";

    const mood =
      visualStrategy?.mood ||
      "";

    const visualStyle =
      visualStrategy?.visualStyle ||
      "";

    const lighting =
      visualStrategy?.lighting ||
      "";

    const composition =
      visualStrategy?.composition ||
      "";

    const camera =
      visualStrategy?.camera ||
      "";

    const colorDirection =
      visualStrategy?.colorDirection ||
      "";

    /*
     * ============================================================
     * BRAND
     * ============================================================
     */

    const brandMentioned =
      brandingStrategy?.brandMentioned === true;

    const brandName =
      brandingStrategy?.brandName?.trim() ||
      "";

    const logoRequired =
      brandingStrategy?.logoRequired === true;

    /*
     * ============================================================
     * AVOID
     * ============================================================
     */

    const avoidItems =
      Array.isArray(avoid)
        ? avoid
            .filter(Boolean)
            .slice(0, 10)
            .join(", ")
        : "";

    /*
     * ============================================================
     * BUILD IMAGE PROMPT
     * ============================================================
     *
     * The most important change:
     *
     * NEVER ASK FLUX TO WRITE THE HEADING.
     *
     * This dramatically reduces spelling problems.
     */

    let finalPrompt = `
Create a professional social media visual.

Generate ONLY the visual artwork/background.

Do NOT generate any words, letters, typography, captions,
headlines, slogans, logos, watermarks, labels or written text.

The final text will be added separately by Postoll.

MAIN SUBJECT:
${mainSubject}

CREATIVE INTENT:
${creativeIntent}

IMAGE DIRECTION:
${imageDirection}

SUPPORTING ELEMENTS:
${secondarySubjects}

ENVIRONMENT:
${environment}

ACTION:
${action}

MOOD:
${mood}

VISUAL STYLE:
${visualStyle}

LIGHTING:
${lighting}

COMPOSITION:
${composition}

CAMERA:
${camera}

COLOR DIRECTION:
${colorDirection}

CONTENT TYPE:
${type}

QUALITY:
- professional advertising photography
- high quality
- realistic materials
- realistic proportions
- believable perspective
- natural shadows
- professional lighting
- strong composition
- clear visual hierarchy
- visually understandable immediately
- polished social media creative
- no random objects
- no generic AI robotics
- no futuristic technology unless explicitly requested
- no sci-fi elements unless explicitly requested
- no watermark
- no logo
- no typography
- no letters
- no words
- no numbers
- no UI
- no border
`;

    /*
     * Brand information can be useful for the visual,
     * but NEVER invent a logo.
     */

    if (
      brandMentioned &&
      brandName
    ) {
      finalPrompt += `

BRAND CONTEXT:
The visual is related to the brand "${brandName}".

Do not create or invent the brand logo.
Do not invent brand typography.
Do not invent brand claims.
`;
    }

    /*
     * Avoid list.
     */

    if (avoidItems) {
      finalPrompt += `

AVOID:
${avoidItems}
`;
    }

    /*
     * ============================================================
     * IMPORTANT USER-TEXT PROTECTION
     * ============================================================
     *
     * Even if Gemini requested text, FLUX must NOT receive it.
     */

    finalPrompt += `

IMPORTANT:
Generate a clean image without any text.

Postoll will add any required heading, quote,
slogan or other requested text after generation.

Do not attempt to spell or render any user-provided text.
`;

    /*
     * ============================================================
     * PROMPT LENGTH
     * ============================================================
     */

    const MAX_PROMPT_LENGTH = 1900;

    if (
      finalPrompt.length >
      MAX_PROMPT_LENGTH
    ) {
      console.log(
        `Prompt length ${finalPrompt.length} exceeds limit. Trimming.`
      );

      finalPrompt =
        finalPrompt.slice(
          0,
          MAX_PROMPT_LENGTH
        );
    }

    finalPrompt =
      finalPrompt.trim();

    if (!finalPrompt) {
      return NextResponse.json(
        {
          error:
            "Unable to create an image prompt.",
        },
        { status: 400 }
      );
    }

    /*
     * ============================================================
     * CLOUDFLARE MODEL
     * ============================================================
     */

    const model =
      "@cf/black-forest-labs/flux-1-schnell";

    const url =
      `https://api.cloudflare.com/client/v4/accounts/` +
      `${accountId}/ai/run/${model}`;

    console.log(
      "================================="
    );

    console.log(
      "Cloudflare image request"
    );

    console.log(
      "Model:",
      model
    );

    console.log(
      "Prompt length:",
      finalPrompt.length
    );

    console.log(
      "Prompt:",
      finalPrompt
    );

    console.log(
      "================================="
    );

    /*
     * ============================================================
     * CALL CLOUDFLARE
     * ============================================================
     *
     * IMPORTANT:
     *
     * Send ONLY prompt.
     *
     * Your current Cloudflare endpoint rejected
     * additional parameters such as seed.
     */

    const cloudflareResponse =
      await fetch(url, {
        method: "POST",

        headers: {
          Authorization:
            `Bearer ${apiToken}`,

          "Content-Type":
            "application/json",
        },

        body: JSON.stringify({
          prompt: finalPrompt,
        }),
      });

    /*
     * ============================================================
     * CLOUDFLARE ERROR
     * ============================================================
     */

    if (!cloudflareResponse.ok) {
      let errorMessage =
        "Cloudflare image generation failed.";

      try {
        const errorData =
          await cloudflareResponse.json();

        console.error(
          "Cloudflare error:",
          errorData
        );

        if (
          Array.isArray(
            errorData?.errors
          ) &&
          errorData.errors.length > 0
        ) {
          errorMessage =
            errorData.errors[0]?.message ||
            errorMessage;
        }
      } catch {
        try {
          const text =
            await cloudflareResponse.text();

          if (text) {
            errorMessage = text;
          }
        } catch {
          // Keep default.
        }
      }

      return NextResponse.json(
        {
          error: errorMessage,
        },
        {
          status:
            cloudflareResponse.status ||
            500,
        }
      );
    }

    /*
     * ============================================================
     * CONTENT TYPE
     * ============================================================
     */

    const contentType =
      cloudflareResponse.headers.get(
        "content-type"
      ) || "";

    console.log(
      "Cloudflare content type:",
      contentType
    );

    /*
     * ============================================================
     * GET GENERATED IMAGE
     * ============================================================
     */

    let imageBuffer: Buffer | null =
      null;

    /*
     * CASE 1:
     *
     * Cloudflare directly returns image bytes.
     */

    if (
      contentType.includes("image/")
    ) {
      const arrayBuffer =
        await cloudflareResponse.arrayBuffer();

      imageBuffer =
        Buffer.from(arrayBuffer);

      console.log(
        "Cloudflare returned direct image."
      );
    }

    /*
     * CASE 2:
     *
     * Cloudflare returns JSON.
     */

    if (!imageBuffer) {
      let data: any;

      try {
        data =
          await cloudflareResponse.json();
      } catch {
        return NextResponse.json(
          {
            error:
              "Cloudflare returned an invalid image response.",
          },
          { status: 500 }
        );
      }

      console.log(
        "Cloudflare image response:",
        data
      );

      const result =
        data?.result;

      /*
       * result.image
       */

      if (
        typeof result?.image ===
        "string"
      ) {
        imageBuffer =
          decodeBase64Image(
            result.image
          );
      }

      /*
       * result string
       */

      if (
        !imageBuffer &&
        typeof result ===
          "string"
      ) {
        imageBuffer =
          decodeBase64Image(
            result
          );
      }

      /*
       * result.images
       */

      if (
        !imageBuffer &&
        Array.isArray(
          result?.images
        ) &&
        result.images.length > 0
      ) {
        const firstImage =
          result.images[0];

        if (
          typeof firstImage ===
          "string"
        ) {
          imageBuffer =
            decodeBase64Image(
              firstImage
            );
        }
      }

      /*
       * data.image
       */

      if (
        !imageBuffer &&
        typeof data?.image ===
          "string"
      ) {
        imageBuffer =
          decodeBase64Image(
            data.image
          );
      }
    }

    /*
     * ============================================================
     * VERIFY IMAGE
     * ============================================================
     */

    if (!imageBuffer) {
      console.error(
        "Cloudflare returned no usable image."
      );

      return NextResponse.json(
        {
          error:
            "Cloudflare generated a response, but Postoll could not find an image in it.",
        },
        { status: 500 }
      );
    }

    console.log(
      "Generated image bytes:",
      imageBuffer.length
    );

    /*
     * ============================================================
     * EXACT TEXT RENDERING
     * ============================================================
     *
     * If no explicit text was requested:
     *
     * return the clean FLUX image immediately.
     */

    if (!shouldRenderText) {
      const base64 =
        imageBuffer.toString(
          "base64"
        );

      return NextResponse.json({
        image:
          `data:image/png;base64,${base64}`,

        textAdded: false,

        requestedText: "",
      });
    }

    /*
     * ============================================================
     * RENDER EXACT USER TEXT
     * ============================================================
     */

    console.log(
      "Rendering exact requested text with Sharp:"
    );

    console.log(
      requestedText
    );

    const finalImageBuffer =
      await addExactText(
        imageBuffer,
        requestedText,
        textStrategy?.placement,
        textStrategy?.style
      );

    const finalBase64 =
      finalImageBuffer.toString(
        "base64"
      );

    console.log(
      "Final image generated successfully."
    );

    return NextResponse.json({
      image:
        `data:image/png;base64,${finalBase64}`,

      textAdded: true,

      requestedText,
    });
  } catch (error) {
    console.error(
      "Generate image error:",
      error
    );

    return NextResponse.json(
      {
        error:
          error instanceof Error
            ? error.message
            : "Unable to generate image.",
      },
      { status: 500 }
    );
  }
}

/*
 * ================================================================
 * BASE64 IMAGE DECODER
 * ================================================================
 */

function decodeBase64Image(
  value: string
): Buffer | null {
  try {
    if (!value) {
      return null;
    }

    /*
     * Handle:
     *
     * data:image/png;base64,...
     */

    if (
      value.startsWith(
        "data:"
      )
    ) {
      const commaIndex =
        value.indexOf(",");

      if (
        commaIndex === -1
      ) {
        return null;
      }

      const base64 =
        value.slice(
          commaIndex + 1
        );

      return Buffer.from(
        base64,
        "base64"
      );
    }

    /*
     * Plain base64.
     */

    return Buffer.from(
      value,
      "base64"
    );
  } catch (error) {
    console.error(
      "Base64 image decode error:",
      error
    );

    return null;
  }
}

/*
 * ================================================================
 * EXACT TEXT RENDERER
 * ================================================================
 *
 * Sharp uses SVG as a text layer.
 *
 * This gives us:
 *
 * - exact spelling
 * - exact punctuation
 * - predictable text
 * - no AI hallucinated letters
 * - controllable placement
 * - controllable size
 *
 * The generated image remains the background.
 */

async function addExactText(
  imageBuffer: Buffer,
  text: string,
  placement?: string,
  style?: string
): Promise<Buffer> {
  /*
   * Get image dimensions.
   */

  const metadata =
    await sharp(imageBuffer)
      .metadata();

  const width =
    metadata.width || 1024;

  const height =
    metadata.height || 1024;

  /*
   * ============================================================
   * TEXT SIZE
   * ============================================================
   */

  const fontSize =
    calculateFontSize(
      width,
      text
    );

  /*
   * ============================================================
   * POSITION
   * ============================================================
   */

  const position =
    getTextPosition(
      placement,
      width,
      height
    );

  /*
   * ============================================================
   * TEXT WRAPPING
   * ============================================================
   */

  const maxTextWidth =
    Math.floor(
      width * 0.82
    );

  const lines =
    wrapText(
      text,
      maxTextWidth,
      fontSize
    );

  /*
   * ============================================================
   * LINE HEIGHT
   * ============================================================
   */

  const lineHeight =
    Math.round(
      fontSize * 1.15
    );

  const totalTextHeight =
    lines.length *
    lineHeight;

  /*
   * ============================================================
   * START Y
   * ============================================================
   */

  let startY =
    position.y;

  if (
    position.vertical ===
    "center"
  ) {
    startY =
      position.y -
      totalTextHeight / 2 +
      fontSize;
  }

  if (
    position.vertical ===
    "bottom"
  ) {
    startY =
      position.y -
      totalTextHeight;
  }

  /*
   * ============================================================
   * TEXT STYLE
   * ============================================================
   *
   * We use a clean, strong default.
   */

  const fontFamily =
    "Arial, Helvetica, sans-serif";

  const fontWeight =
    "700";

  /*
   * White text with a subtle dark shadow
   * works well across most images.
   */

  const fill =
    "#ffffff";

  const stroke =
    "#000000";

  const strokeWidth =
    1.5;

  /*
   * ============================================================
   * SVG TEXT
   * ============================================================
   */

  const escapedLines =
    lines
      .map(
        (line, index) => {
          const y =
            startY +
            index *
              lineHeight;

          return `
            <text
              x="${position.x}"
              y="${y}"
              text-anchor="${position.anchor}"
              font-family="${fontFamily}"
              font-size="${fontSize}px"
              font-weight="${fontWeight}"
              fill="${fill}"
              stroke="${stroke}"
              stroke-width="${strokeWidth}"
              paint-order="stroke"
              stroke-linejoin="round"
            >${escapeXml(line)}</text>
          `;
        }
      )
      .join("");

  /*
   * ============================================================
   * OPTIONAL TEXT BACKPLATE
   * ============================================================
   *
   * We intentionally keep this subtle.
   *
   * It improves readability without making every creative
   * look like the same template.
   */

  const addBackplate =
    shouldUseBackplate(
      style
    );

  let backplate = "";

  if (addBackplate) {
    const boxWidth =
      Math.min(
        width * 0.88,
        maxTextWidth + 80
      );

    const boxHeight =
      totalTextHeight + 50;

    let boxX =
      position.x -
      boxWidth / 2;

    if (
      position.anchor ===
      "start"
    ) {
      boxX =
        position.x - 30;
    }

    if (
      position.anchor ===
      "end"
    ) {
      boxX =
        position.x -
        boxWidth +
        30;
    }

    let boxY =
      startY -
      fontSize -
      25;

    if (
      position.vertical ===
      "center"
    ) {
      boxY =
        startY -
        fontSize -
        25;
    }

    backplate = `
      <rect
        x="${Math.max(
          20,
          boxX
        )}"
        y="${Math.max(
          20,
          boxY
        )}"
        width="${Math.min(
          boxWidth,
          width - 40
        )}"
        height="${boxHeight}"
        rx="22"
        fill="rgba(0,0,0,0.38)"
      />
    `;
  }

  /*
   * ============================================================
   * SVG
   * ============================================================
   */

  const svg = `
    <svg
      width="${width}"
      height="${height}"
      viewBox="0 0 ${width} ${height}"
      xmlns="http://www.w3.org/2000/svg"
    >
      ${backplate}

      ${escapedLines}
    </svg>
  `;

  /*
   * ============================================================
   * COMPOSITE
   * ============================================================
   */

  return sharp(imageBuffer)
    .composite([
      {
        input: Buffer.from(svg),
        top: 0,
        left: 0,
      },
    ])
    .png()
    .toBuffer();
}

/*
 * ================================================================
 * FONT SIZE
 * ================================================================
 */

function calculateFontSize(
  width: number,
  text: string
): number {
  /*
   * Short headings can be larger.
   *
   * Long headings automatically become smaller.
   */

  const length =
    text.length;

  let size =
    Math.round(
      width * 0.075
    );

  if (length > 35) {
    size =
      Math.round(
        width * 0.060
      );
  }

  if (length > 55) {
    size =
      Math.round(
        width * 0.050
      );
  }

  if (length > 80) {
    size =
      Math.round(
        width * 0.042
      );
  }

  /*
   * Safety bounds.
   */

  return Math.max(
    28,
    Math.min(
      size,
      92
    )
  );
}

/*
 * ================================================================
 * TEXT POSITION
 * ================================================================
 */

function getTextPosition(
  placement: string | undefined,
  width: number,
  height: number
): {
  x: number;
  y: number;
  anchor: "start" | "middle" | "end";
  vertical:
    | "top"
    | "center"
    | "bottom";
} {
  const value =
    (placement || "")
      .toLowerCase();

  /*
   * TOP LEFT
   */

  if (
    value.includes("top left") ||
    value.includes("upper left")
  ) {
    return {
      x:
        Math.round(
          width * 0.08
        ),
      y:
        Math.round(
          height * 0.14
        ),
      anchor: "start",
      vertical: "top",
    };
  }

  /*
   * TOP RIGHT
   */

  if (
    value.includes("top right") ||
    value.includes("upper right")
  ) {
    return {
      x:
        Math.round(
          width * 0.92
        ),
      y:
        Math.round(
          height * 0.14
        ),
      anchor: "end",
      vertical: "top",
    };
  }

  /*
   * BOTTOM LEFT
   */

  if (
    value.includes("bottom left") ||
    value.includes("lower left")
  ) {
    return {
      x:
        Math.round(
          width * 0.08
        ),
      y:
        Math.round(
          height * 0.90
        ),
      anchor: "start",
      vertical: "bottom",
    };
  }

  /*
   * BOTTOM RIGHT
   */

  if (
    value.includes("bottom right") ||
    value.includes("lower right")
  ) {
    return {
      x:
        Math.round(
          width * 0.92
        ),
      y:
        Math.round(
          height * 0.90
        ),
      anchor: "end",
      vertical: "bottom",
    };
  }

  /*
   * CENTER
   */

  if (
    value.includes("center") ||
    value.includes("middle")
  ) {
    return {
      x:
        Math.round(
          width / 2
        ),
      y:
        Math.round(
          height / 2
        ),
      anchor: "middle",
      vertical: "center",
    };
  }

  /*
   * DEFAULT:
   *
   * Bottom center is generally safe for social creatives.
   */

  return {
    x:
      Math.round(
        width / 2
      ),
    y:
      Math.round(
        height * 0.88
      ),
    anchor: "middle",
    vertical: "bottom",
  };
}

/*
 * ================================================================
 * TEXT WRAPPING
 * ================================================================
 */

function wrapText(
  text: string,
  maxWidth: number,
  fontSize: number
): string[] {
  /*
   * Approximate character width.
   *
   * This doesn't need to be pixel-perfect because SVG handles
   * the final rendering.
   */

  const averageCharacterWidth =
    fontSize * 0.55;

  const maxCharacters =
    Math.max(
      10,
      Math.floor(
        maxWidth /
          averageCharacterWidth
      )
    );

  const words =
    text.split(/\s+/);

  const lines: string[] = [];

  let current =
    "";

  for (const word of words) {
    const candidate =
      current
        ? `${current} ${word}`
        : word;

    if (
      candidate.length <=
      maxCharacters
    ) {
      current =
        candidate;
    } else {
      if (current) {
        lines.push(
          current
        );
      }

      current =
        word;
    }
  }

  if (current) {
    lines.push(
      current
    );
  }

  return lines.length
    ? lines
    : [text];
}

/*
 * ================================================================
 * BACKPLATE DECISION
 * ================================================================
 */

function shouldUseBackplate(
  style?: string
): boolean {
  const value =
    (style || "")
      .toLowerCase();

  /*
   * If Gemini explicitly asks for no background,
   * don't add one.
   */

  if (
    value.includes(
      "no background"
    ) ||
    value.includes(
      "without background"
    )
  ) {
    return false;
  }

  /*
   * If the style specifically says minimal,
   * avoid the backplate.
   */

  if (
    value.includes(
      "minimal"
    ) ||
    value.includes(
      "clean typography"
    )
  ) {
    return false;
  }

  return true;
}

/*
 * ================================================================
 * XML ESCAPE
 * ================================================================
 *
 * This guarantees that characters such as:
 *
 * &
 * <
 * >
 * "
 * '
 *
 * do not break the SVG.
 *
 * Most importantly, the actual requested wording is preserved.
 */

function escapeXml(
  value: string
): string {
  return value
    .replace(
      /&/g,
      "&amp;"
    )
    .replace(
      /</g,
      "&lt;"
    )
    .replace(
      />/g,
      "&gt;"
    )
    .replace(
      /"/g,
      "&quot;"
    )
    .replace(
      /'/g,
      "&apos;"
    );
}
</file>

